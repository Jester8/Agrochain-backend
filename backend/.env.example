# Copy this file to .env and fill in the values.
# See README.md for step-by-step signup instructions for each free-tier service.

# --- Postgres (CockroachDB Serverless free tier) ---
# cockroachlabs.cloud -> Create Cluster -> Serverless (free) -> "Connect" -> copy the connection string.
# Still uses the postgresql:// scheme - CockroachDB is wire-compatible with Postgres.
DATABASE_URL="postgresql://user:password@free-tier.aws-us-east-1.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full"

# --- Redis (Upstash free tier) ---
# upstash.com -> Create database -> copy the "ioredis" / "Redis Connect" URL (starts with rediss://).
REDIS_URL="rediss://default:password@example.upstash.io:6379"

# --- JWT secrets ---
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# --- Password reset token (short-lived JWT, separate secret from access/refresh) ---
JWT_RESET_SECRET="replace-with-another-long-random-string"
JWT_RESET_EXPIRES_IN="10m"

# --- Email (Resend free tier - 100 emails/day, 3000/month) ---
# resend.com -> API Keys -> Create API Key.
# Leave RESEND_API_KEY empty during local development: OTP codes are printed
# to the server console instead of being emailed, so you can test without a
# domain or waiting on email delivery.
RESEND_API_KEY=""
MAIL_FROM="AgroChain <onboarding@resend.dev>"

# --- App ---
PORT=4000
NODE_ENV=development
OTP_TTL_SECONDS=600

# Comma-separated allowed origins for browser clients (e.g. a future admin
# dashboard). Not needed for the Expo app - only browsers enforce CORS.
# Ignored entirely when NODE_ENV isn't "production".
CORS_ORIGINS=""
