# --- Postgres (Neon) ---
# Neon dashboard -> Connect. DATABASE_URL = the *pooled* string (host contains "-pooler"),
# DIRECT_URL = the direct string (used by `prisma migrate`). Keep ?sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/agrochain?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/agrochain?sslmode=require

# --- Redis (Upstash) - OTP codes ---
REDIS_URL=rediss://default:PASSWORD@xxxx.upstash.io:6379

# --- JWT secrets (generate each with: openssl rand -hex 32) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_RESET_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_RESET_EXPIRES_IN=10m

# --- Email (Brevo) ---
# Leave BREVO_API_KEY blank in development: OTP codes and emails are printed to the console.
BREVO_API_KEY=
MAIL_FROM=AgroChain <hello@agrochain.africa>
BREVO_WAITLIST_LIST_ID=
OPS_EMAIL=info@agrochain.africa

# --- App ---
PORT=4000
NODE_ENV=development
OTP_TTL_SECONDS=600
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
